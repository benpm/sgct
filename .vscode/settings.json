{
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "terminal.integrated.automationProfile.windows": {
        "path": "cmd.exe"
    },
    "json.schemas": [
        {
            "fileMatch": [
                "config/**/*.json"
            ],
            "url": "./sgct.schema.json"
        }
    ],
    "search.exclude": {
        "**/build": true,
        "**/bin": true,
        "**/ext": true
    }
}