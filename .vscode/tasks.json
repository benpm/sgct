{
	"version": "2.0.0",
	"type": "shell",
	"problemMatcher": [
		{
			// from https://github.com/equeim/clang-cl-problem-matcher
			"owner": "clang",
			"pattern": [
				{
					"regexp": "^(.*?)\\((\\d+),(\\d*)\\):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			]
		}
	],
	"options": {
		"cwd": "${workspaceFolder}"
	},
	"tasks": [
		{
			"label": "build debug",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"debug"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "configure debug",
			"command": "cmake",
			"args": [
				"--preset",
				"debug"
			],
			"group": "build",
			"runOptions": {
				"instanceLimit": 1
			},
			"icon": {
				"id": "gear",
				"color": "terminal.ansiBlue"
			}
		}
	]
}