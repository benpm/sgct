    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/bin/Debug/simplecube.exe",
            "args": [
                "--config",
                "config/single_fisheye.json"
