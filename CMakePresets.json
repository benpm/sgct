{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SGCT_EXAMPLES": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "SGCT_FREETYPE_SUPPORT": "OFF",
        "SGCT_DEP_INCLUDE_FREETYPE": "OFF",
        "CMAKE_CXX_COMPILER_LAUNCHER": "python;${sourceDir}/clang-wrapper.py"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": [
        "sgct", "simplecube"
      ],
      "configuration": "Debug"
    }
  ]
}
