{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Windows Visual Studio 2022 Debug",
      "description": "Debug build using Visual Studio 2022 generator with examples and tests",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "SGCT_EXAMPLES": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "SGCT_DEP_INCLUDE_FREETYPE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Windows VS2022 Debug",
      "configurePreset": "debug",
      "targets": [
        "sgct", "simplecube"
      ],
      "configuration": "Debug"
    }
  ]
}
